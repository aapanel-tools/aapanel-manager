# ── Секреты и окружение — НИКОГДА не коммитить ────────────────────────────────
# Перечисление конкретных имён не годится: заводится .env.probe с ключом панели,
# завтра .env.staging — и каждый новый файл до своей строчки здесь коммитится.
# Поэтому запрещено всё, кроме единственного файла без значений.
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
# .mcp.json содержит API-ключи MCP-серверов. Со звёздочкой — потому что копия
# рядом (.mcp.json.bak) содержит ровно те же ключи, а точное имя её не ловит.
.mcp.json*
# Резервные копии чего угодно: их делают второпях и рядом с оригиналом, а
# оригиналом чаще всего оказывается файл с секретами.
*.bak

# ── Зависимости ──────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
yarn.lock

# ── Сборка и вывод ───────────────────────────────────────────────────────────
/.next/
/out/
/build
dist/
# бандл самообновления (scripts/build-release-bundle.mjs)
/release-dist/
*.tsbuildinfo
next-env.d.ts
.vercel

# ── Тесты ────────────────────────────────────────────────────────────────────
/coverage
/test-results/
/playwright-report/

# ── Самообновление (git-режим): runtime-артефакты конкретной установки ────────
.update.lock
.update.log
.update.status
.update-backups/

# ── Логи и временное ─────────────────────────────────────────────────────────
*.log
*.tmp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Артефакты инструментов ───────────────────────────────────────────────────
.playwright-mcp/
.superpowers/

# ── IDE и ОС ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Личные рабочие заметки ───────────────────────────────────────────────────
start.md
HANDOFF.md

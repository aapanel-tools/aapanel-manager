# ── Секреты и окружение — НИКОГДА не коммитить ────────────────────────────────
.env
.env.local
.env*.local
*.key
*.pem
secrets.json
# .mcp.json содержит API-ключи MCP-серверов
.mcp.json

# ── Зависимости ──────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
yarn.lock

# ── Сборка и вывод ───────────────────────────────────────────────────────────
/.next/
/out/
/build
dist/
# бандл самообновления (scripts/build-release-bundle.mjs)
/release-dist/
*.tsbuildinfo
next-env.d.ts
.vercel

# ── Тесты ────────────────────────────────────────────────────────────────────
/coverage
/test-results/
/playwright-report/

# ── Самообновление (git-режим): runtime-артефакты конкретной установки ────────
.update.lock
.update.log
.update.status
.update-backups/

# ── Логи и временное ─────────────────────────────────────────────────────────
*.log
*.tmp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Артефакты инструментов ───────────────────────────────────────────────────
.playwright-mcp/
.superpowers/

# ── IDE и ОС ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Личные рабочие заметки ───────────────────────────────────────────────────
start.md
HANDOFF.md
